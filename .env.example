# Port the server listens on (default 3000)
PORT=3000
# Public base URL used in invoice emails (default http://localhost:PORT)
APP_URL=http://localhost:3000
# Optional - invoice emails are disabled until all three are set
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
# Login. Set a password before running on a server.
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# SESSION_SECRET=
# Set to true to add a read-only demo with fake data
# DEMO_ENABLED=true
